{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PenniLogic immutable D6 design handoff manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "handoff_id", "platform", "status", "artifact", "coverage", "tickets", "contract_versions", "screen_states", "content_ranges", "assets", "accessibility", "localization", "privacy", "telemetry_events", "approvals", "blocking_comments", "checksum"],
  "properties": {
    "kind": { "const": "design_handoff" },
    "schema_version": { "const": 1 },
    "handoff_id": { "type": "string", "pattern": "^HND-(AND|WEB|ADM)-[0-9]{3}$" },
    "platform": { "enum": ["android", "web", "admin"] },
    "status": { "enum": ["draft", "in-review", "approved", "superseded"] },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_key", "version_id", "version_created_at", "frame_ids", "immutable_url"],
      "properties": {
        "file_key": { "type": "string", "minLength": 8 },
        "version_id": { "type": "string", "minLength": 4 },
        "version_created_at": { "type": "string", "format": "date-time" },
        "frame_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "immutable_url": { "type": "string", "format": "uri" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona_ids", "journey_ids", "user_story_ids", "flow_ids", "screen_ids", "component_ids"],
      "properties": {
        "persona_ids": { "$ref": "#/definitions/id_list" },
        "journey_ids": { "$ref": "#/definitions/id_list" },
        "user_story_ids": { "$ref": "#/definitions/id_list" },
        "flow_ids": { "$ref": "#/definitions/id_list" },
        "screen_ids": { "$ref": "#/definitions/id_list" },
        "component_ids": { "$ref": "#/definitions/id_list" }
      }
    },
    "tickets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "implementation", "qa"],
      "properties": {
        "design": { "$ref": "enums.schema.json#/definitions/reference" },
        "implementation": { "$ref": "#/definitions/ref_list" },
        "qa": { "$ref": "#/definitions/ref_list" }
      }
    },
    "contract_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "fields", "errors", "authorization", "freshness"],
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "version": { "type": "string", "minLength": 1 },
          "fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "errors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "authorization": { "type": "string", "minLength": 10 },
          "freshness": { "type": "string", "minLength": 5 }
        }
      }
    },
    "screen_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["screen_id", "designed", "inherited", "exemptions", "synthetic_fixture_ids"],
        "properties": {
          "screen_id": { "type": "string", "pattern": "^S-(AND|WEB|ADM)-[0-9]{3}$" },
          "designed": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
          "inherited": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
          "exemptions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "reason", "approved_by_role"],
              "properties": {
                "state": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "reason": { "type": "string", "minLength": 20 },
                "approved_by_role": { "type": "string", "minLength": 3 }
              }
            }
          },
          "synthetic_fixture_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } }
        }
      }
    },
    "content_ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content_key", "minimum", "typical", "maximum", "empty", "overflow"],
        "properties": {
          "content_key": { "type": "string", "minLength": 2 },
          "minimum": { "type": "string" },
          "typical": { "type": "string" },
          "maximum": { "type": "string" },
          "empty": { "type": "string" },
          "overflow": { "type": "string", "minLength": 5 }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "license", "format", "density_or_scale", "themes", "accessible_name"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 2 },
          "license": { "type": "string", "minLength": 2 },
          "format": { "type": "string", "minLength": 2 },
          "density_or_scale": { "type": "string", "minLength": 1 },
          "themes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
          "accessible_name": { "type": ["string", "null"] }
        }
      }
    },
    "accessibility": { "$ref": "#/definitions/constraint_list" },
    "localization": { "$ref": "#/definitions/constraint_list" },
    "privacy": { "$ref": "#/definitions/constraint_list" },
    "telemetry_events": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" }
    },
    "approvals": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "reviewer", "decision", "decided_at", "expires_at", "artifact_version"],
        "properties": {
          "role": { "type": "string", "minLength": 3 },
          "reviewer": { "type": "string", "minLength": 2 },
          "decision": { "enum": ["approved", "rejected"] },
          "decided_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "artifact_version": { "type": "string", "minLength": 4 }
        }
      }
    },
    "blocking_comments": { "type": "integer", "const": 0 },
    "checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "definitions": {
    "id_list": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" } },
    "ref_list": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "enums.schema.json#/definitions/reference" } },
    "constraint_list": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 10 } }
  }
}
