{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PenniLogic Project 2 field vocabularies",
  "description": "Every enumeration below mirrors an option that exists on the live PenniLogic Delivery project (project-schema.json). A value outside these lists is silently dropped by the GitHub API, so the validator treats it as a hard failure.",
  "definitions": {
    "stable_id": {
      "type": "string",
      "description": "Immutable planning identifier. Epics use E<number>; tickets use T-<AREA>-<NN> or T-<AREA>-<REPO>-<NN>.",
      "pattern": "^(E[0-9]{2,}|T-[A-Z0-9]+(-[A-Z0-9]+)*)$"
    },
    "issue_ref": {
      "type": "string",
      "description": "A live GitHub issue in the PenniLogic org, as repo#number.",
      "pattern": "^(admin|ai-service|android|api|contracts|docs|infra|web)#[0-9]+$"
    },
    "reference": {
      "description": "Either a stable id defined in this source or a live issue reference.",
      "anyOf": [
        {
          "$ref": "#/definitions/stable_id"
        },
        {
          "$ref": "#/definitions/issue_ref"
        }
      ]
    },
    "repo": {
      "enum": [
        "admin",
        "ai-service",
        "android",
        "api",
        "contracts",
        "docs",
        "infra",
        "web"
      ]
    },
    "kind": {
      "enum": [
        "Epic",
        "Story",
        "Task",
        "Spike",
        "Bug",
        "Chore"
      ]
    },
    "phase": {
      "enum": [
        "P0 Foundations",
        "P1 Debt Engine",
        "P2 Automation",
        "P3 Reach",
        "P4 Network",
        "P5 Intelligence",
        "P6 Moat"
      ]
    },
    "sprint": {
      "enum": [
        "Backlog",
        "Sprint 01",
        "Sprint 02",
        "Sprint 03",
        "Sprint 04",
        "Sprint 05",
        "Sprint 06",
        "Sprint 07",
        "Sprint 08",
        "Sprint 09",
        "Sprint 10",
        "Sprint 11",
        "Sprint 12",
        "Sprint 13",
        "Sprint 14",
        "Sprint 15",
        "Sprint 16",
        "Sprint 17",
        "Sprint 18",
        "Future"
      ]
    },
    "component": {
      "enum": [
        "android",
        "api",
        "ai-service",
        "web",
        "admin",
        "contracts",
        "infra",
        "docs",
        "cross-cutting"
      ]
    },
    "priority": {
      "enum": [
        "P0 Critical",
        "P1 High",
        "P2 Medium",
        "P3 Low"
      ]
    },
    "perspective": {
      "enum": [
        "Product",
        "Architecture",
        "Development",
        "Test",
        "QA",
        "Security",
        "Compliance",
        "Ops"
      ]
    },
    "risk": {
      "enum": [
        "R1 SMS permission",
        "R2 User retention",
        "R3 Breach",
        "R4 Insider risk",
        "R5 Scope",
        "R6 Parser rot",
        "R7 AI cost",
        "R8 Sharing abuse",
        "R9 Advice boundary",
        "R10 Wrong numbers",
        "R11 Prompt injection",
        "R12 Billing economics",
        "R13 Split conversion",
        "R14 Key-person",
        "R15 Data lifecycle",
        "None"
      ]
    },
    "status": {
      "enum": [
        "Backlog",
        "Ready",
        "In Progress",
        "In Review",
        "In Test",
        "Blocked",
        "Done"
      ]
    },
    "estimate": {
      "description": "Fibonacci points. 1, 2 and 21 or more are deliberately excluded: anything larger than 13 must be split before it enters a sprint.",
      "enum": [
        3,
        5,
        8,
        13
      ]
    },
    "capacity_pool": {
      "enum": [
        "Engineering",
        "Product Design and UX",
        "Quality Assurance"
      ]
    },
    "prose_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[\\x20-\\x7E]+$"
      }
    },
    "prose_list_optional": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[\\x20-\\x7E]+$"
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
    }
  }
}
