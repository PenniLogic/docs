    {"id": "product_owner", "responsibility": "basiltt remains the actual accountable product owner; delegated decisions are attributed, not new human appointments."},
    {"id": "decision_coordinator", "responsibility": "Root exercises the delegated CDO-equivalent scopes only; no claim of a human CDO, legal qualification or additional vote."},
    {"id": "design_ops", "responsibility": "Design governance, exclusive ownership, topology, queues, immutable decisions and archive integrity."},
    {"id": "research", "responsibility": "Research methods, synthesis limitations and accept/revise/decline/defer dispositions; no participant contact without operational start evidence."},
    {"id": "service_design", "responsibility": "Personas, jobs, journeys, service blueprints and canonical information architecture."},
    {"id": "android_design", "responsibility": "Android flows, screens, prototypes and platform fidelity."},
    {"id": "web_design", "responsibility": "Customer-web flows, screens, prototypes and responsive behavior."},
    {"id": "admin_design", "responsibility": "Operator flows, screens, prototypes and role-aware safety."},
    {"id": "systems", "responsibility": "Foundations, tokens, shared components and additive library releases."},
    {"id": "content", "responsibility": "Terminology, source copy, regulated-copy routing and localization."},
    {"id": "accessibility", "responsibility": "Accessibility evidence, inclusive design and independent acceptance; cannot waive safety invariants."},
    {"id": "ux_engineering", "responsibility": "Versioned handoff, component mapping, assets and design-to-code contracts."},
    {"id": "design_qa", "responsibility": "Independent critique, prototype evidence, conformance and design QA; never own-author verification."},
    {"id": "engineering", "responsibility": "Implementation feasibility and build conformance; engineering governance remains in DELIVERY.md."},
    {"id": "privacy", "responsibility": "Independent data minimization, access, sharing, retention and research privacy review."},
    {"id": "security", "responsibility": "Independent abuse, authorization and security review; technical delegation is not security acceptance."},
    {"id": "legal", "responsibility": "Qualified legal review when required by research or regulated copy. Unassigned; an AI role label is not counsel, consent or licensed advice."},
    {"id": "research_store_owner", "responsibility": "Controlled research-store ownership, access inventory, offboarding, retention and deletion evidence. Unassigned until an actual store and accountable context are verified."},
    {"id": "release", "responsibility": "Independent release-evidence verification; no deployment or publishing authority is created here."}
