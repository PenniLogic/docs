{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/PenniLogic/docs/blob/main/governance/figma-libraries.schema.json",
  "title": "Governed Figma libraries, component contribution and release records",
  "description": "T-DSY-02 (PenniLogic/docs#78) source contract. Self-contained draft-07 subset; nullable objects (accessibility, deprecation, cdo_approval, decision_source) are shape-checked in scripts/check_figma_libraries.py against the named definitions. SemVer and branch rules are those of governance/design-operations.md section 6; roles come from governance/design-gates.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "source_issue",
    "plan_id",
    "registry_ref",
    "direction_ref",
    "access",
    "libraries",
    "releases",
    "components",
    "tabletop",
    "approvals"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "contract_version": {
      "$ref": "#/definitions/version"
    },
    "source_issue": {
      "const": "PenniLogic/docs#78"
    },
    "plan_id": {
      "const": "T-DSY-02"
    },
    "registry_ref": {
      "$ref": "#/definitions/source"
    },
    "direction_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_links_enabled",
        "external_sharing_enabled",
        "asset_export_enabled",
        "offboarding_revokes"
      ],
      "properties": {
        "public_links_enabled": {
          "type": "boolean"
        },
        "external_sharing_enabled": {
          "type": "boolean"
        },
        "asset_export_enabled": {
          "type": "boolean"
        },
        "offboarding_revokes": {
          "type": "boolean"
        }
      }
    },
    "libraries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/library"
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/release"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/component"
      }
    },
    "tabletop": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/scenario"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/approval"
      }
    }
  },
  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*$(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])"
    },
    "optional_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])"
    },
    "component_id": {
      "type": "string",
      "pattern": "^C-[A-Z][A-Z0-9]{0,11}(-[A-Z][A-Z0-9]{0,11}){0,3}$(?![\\s\\S])"
    },
    "optional_component_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^C-[A-Z][A-Z0-9]{0,11}(-[A-Z][A-Z0-9]{0,11}){0,3}$(?![\\s\\S])"
    },
    "library_id": {
      "enum": [
        "LIB-FOUNDATION",
        "LIB-COMPONENTS",
        "LIB-ANDROID",
        "LIB-WEB",
        "LIB-ADMIN",
        "LIB-CANDIDATE"
      ]
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "issue_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(pending:)?PenniLogic/[a-z][a-z0-9-]*#[1-9][0-9]{0,5}$(?![\\s\\S])"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "path",
        "sha256"
      ],
      "properties": {
        "commit": {
          "$ref": "#/definitions/commit"
        },
        "path": {
          "$ref": "#/definitions/text"
        },
        "sha256": {
          "$ref": "#/definitions/digest"
        }
      }
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "figma_file",
        "figma_page",
        "owner_role",
        "publish_roles",
        "consumes",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/library_id"
        },
        "kind": {
          "enum": [
            "foundation",
            "shared_semantic",
            "platform_variant",
            "candidate"
          ]
        },
        "figma_file": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "figma_page": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "owner_role": {
          "$ref": "#/definitions/role"
        },
        "publish_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/role"
          }
        },
        "consumes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/library_id"
          }
        },
        "status": {
          "enum": [
            "shell",
            "active",
            "frozen"
          ]
        }
      }
    },
    "cdo_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "scope",
        "status",
        "decision_source"
      ],
      "properties": {
        "role": {
          "const": "decision_coordinator"
        },
        "scope": {
          "const": "shared_system_major"
        },
        "status": {
          "enum": [
            "pending",
            "recorded"
          ]
        },
        "decision_source": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "library",
        "version",
        "previous",
        "change_class",
        "breaking",
        "status",
        "migration_plan_ref",
        "cdo_approval",
        "rollback_to"
      ],
      "properties": {
        "library": {
          "$ref": "#/definitions/library_id"
        },
        "version": {
          "$ref": "#/definitions/version"
        },
        "previous": {
          "$ref": "#/definitions/optional_version"
        },
        "change_class": {
          "enum": [
            "major",
            "minor",
            "patch"
          ]
        },
        "breaking": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "draft",
            "published",
            "rolled_back"
          ]
        },
        "migration_plan_ref": {
          "$ref": "#/definitions/issue_ref"
        },
        "cdo_approval": {
          "type": [
            "object",
            "null"
          ]
        },
        "rollback_to": {
          "$ref": "#/definitions/optional_version"
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "values",
        "default",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]{0,39}$(?![\\s\\S])"
        },
        "type": {
          "enum": [
            "boolean",
            "enum",
            "text",
            "slot",
            "instance"
          ]
        },
        "values": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/text"
          }
        },
        "default": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "accessible_name",
        "focus",
        "announcements"
      ],
      "properties": {
        "role": {
          "$ref": "#/definitions/text"
        },
        "accessible_name": {
          "$ref": "#/definitions/text"
        },
        "focus": {
          "$ref": "#/definitions/text"
        },
        "announcements": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replacement",
        "removal_version",
        "available_until_removal"
      ],
      "properties": {
        "replacement": {
          "$ref": "#/definitions/optional_component_id"
        },
        "removal_version": {
          "$ref": "#/definitions/optional_version"
        },
        "available_until_removal": {
          "type": "boolean"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "library",
        "status",
        "semantic_role",
        "owner_role",
        "description",
        "platforms",
        "properties",
        "accessibility",
        "variant_of",
        "since_version",
        "deprecation",
        "proposal_branch",
        "token_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/component_id"
        },
        "name": {
          "$ref": "#/definitions/text"
        },
        "library": {
          "$ref": "#/definitions/library_id"
        },
        "status": {
          "enum": [
            "draft",
            "candidate",
            "published",
            "deprecated"
          ]
        },
        "semantic_role": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "owner_role": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z_]*$(?![\\s\\S])"
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": {
            "enum": [
              "android",
              "web",
              "admin"
            ]
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/property"
          }
        },
        "accessibility": {
          "type": [
            "object",
            "null"
          ]
        },
        "variant_of": {
          "$ref": "#/definitions/optional_component_id"
        },
        "since_version": {
          "$ref": "#/definitions/optional_version"
        },
        "deprecation": {
          "type": [
            "object",
            "null"
          ]
        },
        "proposal_branch": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "token_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/text"
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "role",
        "library",
        "offboarded",
        "expected",
        "evidence_class",
        "live_verified"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TT-[0-9]{2}$(?![\\s\\S])"
        },
        "action": {
          "enum": [
            "view",
            "comment",
            "edit",
            "publish",
            "public_link",
            "export"
          ]
        },
        "role": {
          "$ref": "#/definitions/role"
        },
        "library": {
          "$ref": "#/definitions/library_id"
        },
        "offboarded": {
          "type": "boolean"
        },
        "expected": {
          "enum": [
            "refused",
            "model_permitted"
          ]
        },
        "evidence_class": {
          "const": "tabletop"
        },
        "live_verified": {
          "type": "boolean"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "status"
      ],
      "properties": {
        "role": {
          "$ref": "#/definitions/role"
        },
        "status": {
          "enum": [
            "not_recorded",
            "pending"
          ]
        }
      }
    }
  }
}
