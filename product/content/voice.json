  "max_sentence_words": 20,
  "taxonomy_copy_rules": [
    "no_blame",
    "no_invented_cause",
    "no_internal_detail",
    "no_hidden_data_disclosure",
    "same_wording",
    "one_action",
    "positive_framing",
    "plain_language",
    "no_money_in_state_copy",
    "calm_tone"
  ],
  "principles": [
    {
      "id": "voice.say_what_happened",
      "rule": "Say what happened, what remains safe, what the person can do and what happens next, in that order, using only facts the surface knows."
    },
    {
      "id": "voice.no_blame",
      "rule": "Describe the situation, not the person; debt and corrections are facts to work with, never a judgement of character."
    },
    {
      "id": "voice.show_uncertainty",
      "rule": "Label every projection, scenario and estimate as such and name what it depends on; never present a calculation as a promise."
    },
    {
      "id": "voice.calculator_not_adviser",
      "rule": "Explain the arithmetic of the person's own data and the trade-offs between choices they select; never tell them which financial product to buy or sell."
    },
    {
      "id": "voice.name_consequences",
      "rule": "State a destructive or irreversible consequence before the action, in plain words, and never hide it behind a link."
    },
    {
      "id": "voice.one_term",
      "rule": "Use the preferred glossary label for each concept on every platform; do not switch synonyms within a flow."
    },
    {
      "id": "voice.discreet_by_default",
      "rule": "Notifications and lock-screen text name no amounts, people, merchants or shared data; neutral safe-exit keys cover shared-device and coercive contexts."
    }
  ],
