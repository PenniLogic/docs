  "conventions": [
    {
      "id": "convention.sentence_case",
      "rule": "Headlines, labels and buttons use sentence case and no terminal full stop."
    },
    {
      "id": "convention.minor_units",
      "rule": "Amounts come from the ledger as integer minor units with a currency code and are formatted by the client locale formatter; copy never hard-codes a currency symbol, separator or rounding."
    },
    {
      "id": "convention.one_currency_per_total",
      "rule": "Totals in different currencies are shown separately and never silently combined into one figure."
    },
    {
      "id": "convention.dates",
      "rule": "Dates are absolute and locale formatted; relative phrases such as yesterday are used only next to the absolute date."
    },
    {
      "id": "convention.rates",
      "rule": "Rates are shown as a percentage with the period named, such as APR per year."
    },
    {
      "id": "convention.plurals",
      "rule": "Counts use the locale plural rules supplied with each key; copy never builds a plural by adding letters."
    },
    {
      "id": "convention.ranges",
      "rule": "Every key declares minimum, typical and maximum character counts so translated and pseudo-localized copy fits before layout approval."
    }
  ],
