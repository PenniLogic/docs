{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/PenniLogic/docs/product/content/voice.schema.json",
  "title": "PenniLogic voice, conventions and content patterns (T-CNT-01, PenniLogic/docs#84)",
  "description": "Shape only. The taxonomy copy rules and forbidden terms are imported by identifier from product/client-state-taxonomy.json and never restated; numeric bounds, pattern coverage and key references are enforced by scripts/check_content.py.",
  "type": "object",
  "required": [
    "schema_version",
    "voice_version",
    "source_issue",
    "reading_level",
    "max_sentence_words",
    "taxonomy_copy_rules",
    "principles",
    "banned_patterns",
    "conventions",
    "patterns"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "voice_version": {
      "type": "string",
      "minLength": 5
    },
    "source_issue": {
      "const": "PenniLogic/docs#84"
    },
    "reading_level": {
      "type": "object",
      "required": [
        "target",
        "status",
        "evidence_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "provisional",
            "confirmed"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "max_sentence_words": {
      "type": "integer"
    },
    "taxonomy_copy_rules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/principle"
      }
    },
    "banned_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/banned_pattern"
      }
    },
    "conventions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/principle"
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/pattern"
      }
    }
  },
  "definitions": {
    "principle": {
      "type": "object",
      "required": [
        "id",
        "rule"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "banned_pattern": {
      "type": "object",
      "required": [
        "id",
        "category",
        "phrase"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "shame",
            "guarantee",
            "hype",
            "advice"
          ]
        },
        "phrase": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pattern": {
      "type": "object",
      "required": [
        "id",
        "taxonomy_state",
        "slots"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "empty",
            "loading",
            "error",
            "stale",
            "denied",
            "destructive",
            "success",
            "recovery"
          ]
        },
        "taxonomy_state": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "slots": {
          "type": "object",
          "required": [
            "source",
            "status",
            "consequence",
            "safe_remainder",
            "next_action"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "$ref": "#/definitions/slot"
            },
            "status": {
              "$ref": "#/definitions/slot"
            },
            "consequence": {
              "$ref": "#/definitions/slot"
            },
            "safe_remainder": {
              "$ref": "#/definitions/slot"
            },
            "next_action": {
              "$ref": "#/definitions/slot"
            }
          }
        }
      }
    },
    "slot": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}
