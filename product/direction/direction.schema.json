{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/PenniLogic/docs/blob/main/product/direction/direction.schema.json",
  "title": "PenniLogic concept directions, probes and pending D2 direction record (T-UXR-07)",
  "description": "Shapes of product/direction/candidates.json (definition candidate_set), probes.json (probe_set) and direction-record.json (direction_record). Draft-07 subset validated by scripts/check_direction.py without third-party packages; numeric and length bounds, grammars beyond the patterns, contrast, evidence, approval and token-contract rules are enforced in code. Some enums admit values the validator refuses (AI, internal-vote, synthetic or mood-board evidence; a final token contract; a non-pending status) so the refusal carries a specific static rule identifier. A non-null decision is validated against the decision definition in code, because the subset has no anyOf.",
  "definitions": {
    "semantic_role": {
      "type": "string",
      "enum": [
        "surface",
        "surface_raised",
        "text_primary",
        "text_secondary",
        "control_boundary",
        "focus_indicator",
        "emphasis",
        "progress",
        "uncertainty",
        "provenance",
        "warning",
        "control"
      ]
    },
    "source_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "path",
        "sha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    },
    "illustrative_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "srgb"
      ],
      "properties": {
        "role": {
          "$ref": "#/definitions/semantic_role"
        },
        "srgb": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}(?![\\s\\S])"
        }
      }
    },
    "contrast_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "foreground",
        "background",
        "result"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "large_text",
            "ui"
          ]
        },
        "foreground": {
          "$ref": "#/definitions/semantic_role"
        },
        "background": {
          "$ref": "#/definitions/semantic_role"
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "persona_assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "validated"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "validated": {
          "type": "boolean"
        }
      }
    },
    "feasibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "density",
        "reduced_motion",
        "localization_expansion",
        "android",
        "web",
        "admin"
      ],
      "properties": {
        "density": {
          "type": "string",
          "minLength": 1
        },
        "reduced_motion": {
          "type": "string",
          "minLength": 1
        },
        "localization_expansion": {
          "type": "string",
          "minLength": 1
        },
        "android": {
          "type": "string",
          "minLength": 1
        },
        "web": {
          "type": "string",
          "minLength": 1
        },
        "admin": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "material_tradition",
        "graphic_tradition",
        "category_default",
        "rationale",
        "intended_feel",
        "form_language",
        "signature_interaction",
        "content_behavior",
        "risks",
        "accessibility_notes",
        "persona_assumptions",
        "grounding",
        "illustrative_values",
        "contrast_pairs",
        "feasibility"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DIR-[0-9]{2}(?![\\s\\S])"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "material_tradition": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*(?![\\s\\S])"
        },
        "graphic_tradition": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*(?![\\s\\S])"
        },
        "category_default": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "intended_feel": {
          "type": "string",
          "minLength": 1
        },
        "form_language": {
          "type": "string",
          "minLength": 1
        },
        "signature_interaction": {
          "type": "string",
          "minLength": 1
        },
        "content_behavior": {
          "type": "string",
          "minLength": 1
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "accessibility_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "persona_assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/persona_assumption"
          }
        },
        "grounding": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/source_pin"
          }
        },
        "illustrative_values": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binding",
            "values"
          ],
          "properties": {
            "binding": {
              "type": "boolean"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/illustrative_value"
              }
            }
          }
        },
        "contrast_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/contrast_pair"
          }
        },
        "feasibility": {
          "$ref": "#/definitions/feasibility"
        }
      }
    },
    "candidate_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "source_issue",
        "plan_id",
        "status",
        "candidates"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "direction_candidates"
        },
        "source_issue": {
          "type": "string",
          "const": "PenniLogic/docs#76"
        },
        "plan_id": {
          "type": "string",
          "const": "T-UXR-07"
        },
        "status": {
          "type": "string",
          "const": "proposal"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/candidate"
          }
        }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "description"
      ],
      "properties": {
        "candidate": {
          "type": "string",
          "pattern": "^DIR-[0-9]{2}(?![\\s\\S])"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topic",
        "format",
        "data_origin",
        "access_depiction",
        "scenario",
        "renderings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PRB-[0-9]{2}(?![\\s\\S])"
        },
        "topic": {
          "type": "string",
          "enum": [
            "debt_progress",
            "transaction_clarification",
            "household_privacy",
            "operator_urgency"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "text",
            "html",
            "svg",
            "script"
          ]
        },
        "data_origin": {
          "type": "string",
          "enum": [
            "synthetic",
            "restricted_live",
            "production"
          ]
        },
        "access_depiction": {
          "type": "string",
          "enum": [
            "none",
            "explicit_revocable_grant",
            "audited_elevation",
            "ordinary_browsing"
          ]
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "renderings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/rendering"
          }
        }
      }
    },
    "probe_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "source_issue",
        "probes"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "direction_probes"
        },
        "source_issue": {
          "type": "string",
          "const": "PenniLogic/docs#76"
        },
        "probes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/probe"
          }
        }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "study_ref",
        "data_origin",
        "state"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "representative_user_study",
            "ai_preference",
            "internal_vote",
            "synthetic_participant",
            "mood_board_preference"
          ]
        },
        "study_ref": {
          "type": "string",
          "pattern": "^(pending:)?PenniLogic/(docs|android|web|admin|api|contracts|infra)#[1-9][0-9]*(?![\\s\\S])"
        },
        "data_origin": {
          "type": "string",
          "enum": [
            "pending",
            "restricted_live",
            "synthetic_fixture"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "accepted"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "state",
        "reviewer_ref"
      ],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*(?![\\s\\S])"
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "recorded"
          ]
        },
        "reviewer_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected",
        "rejected",
        "approver_role",
        "approver_ref",
        "signed_at",
        "signature_ref"
      ],
      "properties": {
        "selected": {
          "type": "string",
          "pattern": "^DIR-[0-9]{2}(?![\\s\\S])"
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DIR-[0-9]{2}(?![\\s\\S])"
          }
        },
        "approver_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*(?![\\s\\S])"
        },
        "approver_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "signed_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "signature_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "semantic_role_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "meaning"
      ],
      "properties": {
        "role": {
          "$ref": "#/definitions/semantic_role"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unresolved_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "state",
        "owner_ref"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "mitigated",
            "accepted"
          ]
        },
        "owner_ref": {
          "type": "string",
          "pattern": "^PenniLogic/(docs|android|web|admin|api|contracts|infra)#[1-9][0-9]*(?![\\s\\S])"
        }
      }
    },
    "direction_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "version",
        "gate",
        "artifact_class",
        "source_issue",
        "plan_id",
        "status",
        "prepared_by",
        "candidates_considered",
        "participant_count",
        "evidence",
        "decision",
        "reviews",
        "semantic_roles",
        "platform_consequences",
        "unresolved_risks",
        "implementation_consequences",
        "token_contract",
        "supersession",
        "consumers",
        "held_gates"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "direction_record"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "type": "string",
          "const": "D2"
        },
        "artifact_class": {
          "type": "string",
          "const": "visual_direction"
        },
        "source_issue": {
          "type": "string",
          "const": "PenniLogic/docs#76"
        },
        "plan_id": {
          "type": "string",
          "const": "T-UXR-07"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "superseded"
          ]
        },
        "prepared_by": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "ref"
          ],
          "properties": {
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*(?![\\s\\S])"
            },
            "ref": {
              "type": "string",
              "pattern": "^PenniLogic/(docs|android|web|admin|api|contracts|infra)#[1-9][0-9]*(?![\\s\\S])"
            }
          }
        },
        "candidates_considered": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DIR-[0-9]{2}(?![\\s\\S])"
          }
        },
        "participant_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence_item"
          }
        },
        "decision": {
          "type": [
            "object",
            "null"
          ]
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/review"
          }
        },
        "semantic_roles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/semantic_role_entry"
          }
        },
        "platform_consequences": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "android",
            "web",
            "admin"
          ],
          "properties": {
            "android": {
              "type": "string",
              "minLength": 1
            },
            "web": {
              "type": "string",
              "minLength": 1
            },
            "admin": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "unresolved_risks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/unresolved_risk"
          }
        },
        "implementation_consequences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "token_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "owner_issue",
            "reference"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "not_started",
                "draft",
                "final"
              ]
            },
            "owner_issue": {
              "type": "string",
              "const": "PenniLogic/docs#55"
            },
            "reference": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "supersession": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supersedes",
            "requires"
          ],
          "properties": {
            "supersedes": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "requires": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PenniLogic/(docs|android|web|admin|api|contracts|infra)#[1-9][0-9]*(?![\\s\\S])"
          }
        },
        "held_gates": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^pending:PenniLogic/(docs|android|web|admin|api|contracts|infra)#[1-9][0-9]*(?![\\s\\S])"
          }
        }
      }
    }
  }
}
